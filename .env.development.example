# Copy to .env.development only after creating/selecting a dedicated DEV project.
# Never put Production credentials here. This file contains placeholders only.

APP_ENV=development
DATABASE_ROLE=development
SUPABASE_URL=https://replace-with-dev-project-ref.supabase.co
CURRENT_SUPABASE_PROJECT_REF=replace-with-dev-project-ref
BOT_STATE_SCHEMA=public

# Public client key; never use it as a substitute for backend access control.
SUPABASE_ANON_KEY=
# Backend-only secret. Keep blank until a DEV service-role key is issued.
SUPABASE_SERVICE_ROLE_KEY=

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GEMINI_API_KEY=
LOG_LEVEL=INFO
