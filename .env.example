# LINE Developers Console → Messaging API channel
LINE_CHANNEL_SECRET=replace-with-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-long-lived-access-token

# Supabase Project Settings → API (backend use only; never expose in frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
CURRENT_SUPABASE_PROJECT_REF=your-project-ref
DATABASE_ROLE=development
# Set only after a distinct real Production project exists.
# PRODUCTION_SUPABASE_PROJECT_REF=
# Current competition-safe Production contract keeps existing Bot state in public.
BOT_STATE_SCHEMA=public
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional integration-test project. Never point either value at production.
TEST_SUPABASE_URL=
TEST_SUPABASE_KEY=

# Google AI Studio → API key.  Leave blank to use the built-in safe wording fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Server
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# EV suitability policy (km/day).  Used only for the household 110V assessment.
EV_HOME_110V_GOOD_MAX_DAILY_KM=40
EV_HOME_110V_WARNING_MAX_DAILY_KM=80
